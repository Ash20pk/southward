# Copy to .env.local for local development. On Vercel, set these in Project Settings > Environment Variables.

# --- AI: set ONE key. With only OPENAI_API_KEY set, the app uses OpenAI automatically. ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# AI_PROVIDER=openai            # force a provider when both keys are set
# OPENAI_MODEL=gpt-5.5
# ANTHROPIC_MODEL=claude-opus-5

# --- Accounts and sync (optional locally, required on Vercel) ---
# Leave DATABASE_URL and AUTH_SECRET unset to run in browser-only mode with no login.
# Local database: `npm run db:up`, then use this URL:
# DATABASE_URL=postgres://postgres:postgres@db.localtest.me:5432/southward
# On Vercel, the Neon integration sets DATABASE_URL for you.
DATABASE_URL=
# Signs login sessions. Generate one with: openssl rand -base64 32
AUTH_SECRET=
# Max AI requests per user per day (protects your API bill). Default 300.
# AI_DAILY_LIMIT=300
# Max AI requests per day across ALL users combined. Default 1000.
# AI_SITE_DAILY_LIMIT=1000
