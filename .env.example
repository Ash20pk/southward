# Copy this file to .env.local and set ONE of these keys.
# With only an OpenAI key set, the app uses OpenAI automatically.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional: force a provider when both keys are set ("openai" or "anthropic")
# AI_PROVIDER=openai

# Optional: override the models
# OPENAI_MODEL=gpt-5.5
# ANTHROPIC_MODEL=claude-opus-5
