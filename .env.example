# Copy to .env.local for local development. On Vercel, set these in Project Settings > Environment Variables.

# --- AI: set ONE key. With only OPENAI_API_KEY set, the app uses OpenAI automatically. ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# AI_PROVIDER=openai            # force a provider when both keys are set
# OPENAI_MODEL=gpt-5.5
# ANTHROPIC_MODEL=claude-opus-5

# --- Live conversation in clinical stations (needs OPENAI_API_KEY, whichever provider writes the text) ---
# The patient is one live voice call (OpenAI Realtime over WebRTC). Without the key, stations run turn by turn.
# OPENAI_REALTIME_MODEL=gpt-realtime-2.1-mini
# OPENAI_REALTIME_REASONING_EFFORT=minimal   # only for reasoning-capable realtime models
# Live stations per user per day, and across all users. Defaults 20 and 500.
# LIVE_DAILY_LIMIT=20
# LIVE_SITE_DAILY_LIMIT=500

# --- Accounts and sync (optional locally, required on Vercel) ---
# Leave DATABASE_URL and the NEON_AUTH_* values unset to run in browser-only mode with no login.
# Local database: `npm run db:up`, then use this URL:
# DATABASE_URL=postgres://postgres:postgres@db.localtest.me:5432/southward
# On Vercel, the Neon integration sets DATABASE_URL for you.
DATABASE_URL=
# Accounts use Neon Auth on the same Neon branch. Find the URL with `neon neon-auth status` (Base URL).
NEON_AUTH_BASE_URL=
# Signs the cached session cookie. Generate one with: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=
# Max AI requests per user per day (protects your API bill). Default 300.
# AI_DAILY_LIMIT=300
# Max AI requests per day across ALL users combined. Default 1000.
# AI_SITE_DAILY_LIMIT=1000

# --- TypeSafe JEV (optional): fast judging for clinical station marking and PDF source checks ---
# Without it, the LLM does the marking and PDF output isn't source-checked.
# TYPESAFE_API_KEY=
# TYPESAFE_MODEL=jev-latest
# OpenAI reasoning effort for every call (default low, fastest)
# OPENAI_REASONING_EFFORT=low

# --- Public website ---
# The site's address, for the sitemap, canonical links and share cards. On Vercel it defaults to the
# production URL; set this once there's a custom domain.
# NEXT_PUBLIC_SITE_URL=https://southward.example
# Shown as the contact address in the footer and privacy policy. Hidden when unset.
# NEXT_PUBLIC_CONTACT_EMAIL=
